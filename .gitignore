# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local databases and logs
/prisma/dev.db
/prisma/dev.db-journal
*.log

# build outputs and deploy directories
/deploy-standalone/
/_deploy_min/
/_deploy_staging/
/deploy-source/
node_modules/

# archives
*.zip
*.tgz
*.tar.gz
*.gz
_data/

# editor and agent configs
/.agents/
/.claude/
/.windsurf/
/skills-lock.json
__pycache__/
*.pyc

# user uploads
/public/uploads/
/public/New files/

# temp scripts
/scratch_temp.js
/test-tasks.js
/test-tasks.ts
/check-db.js

