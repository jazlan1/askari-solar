{
  "name": "askari-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "chmod -R 755 . 2>/dev/null || true",
    "build": "prisma generate && next build --webpack && node scripts/post-build.js",
    "start": "node scripts/start.js",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "db:push-local": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:generate-local": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:studio-local": "prisma studio --schema=prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^16.0.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.5",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.12.0",
    "mariadb": "^3.4.0",
    "next": "16.2.12",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1"
  }
}
